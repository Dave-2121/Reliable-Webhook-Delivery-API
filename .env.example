# Copy to .env and edit if needed. Every value has the same default in src/config.js,
# so the app also runs with no .env file when using the docker-compose MySQL.
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=webhooks
# Tests run against a separate database so they never touch real data.
TEST_DB_NAME=webhooks_test

# Delivery behaviour
DELIVERY_TIMEOUT_MS=5000
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_RETRY_BASE_DELAY_MS=500
